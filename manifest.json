{
  "manifestVersion": 5,
  "id": "com.cyrilplugin.premieremotiontracker",
  "name": "Premiere Motion Tracker",
  "version": "0.1.3",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "id": "pmt-main",
      "type": "panel",
      "label": {
        "default": "Motion Tracker"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 520,
        "height": 760
      }
    }
  ]
}
