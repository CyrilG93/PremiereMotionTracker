{
  "manifestVersion": 6,
  "id": "com.cyrilplugin.premieremotiontracker",
  "name": "Motion Tracker",
  "version": "0.5.12",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "enableAddon": true
  },
  "addon": {
    "name": "premiere-motion-tracker-0.5.12.uxpaddon"
  },
  "entrypoints": [
    {
      "id": "pmt-main",
      "type": "panel",
      "label": {
        "default": "Motion Tracker"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 520,
        "height": 760
      }
    }
  ]
}
